{
  "name": "apex-code-ai",
  "displayName": "Apex Code AI - Code Reviewer",
  "description": "Multi-Model Automated Code Intelligence inside VS Code",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onView:apexCodeAiView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apex-code-ai-sidebar",
          "title": "Apex Code AI",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "apex-code-ai-sidebar": [
        {
          "id": "apexCodeAiView",
          "name": "Code Reviewer"
        }
      ]
    },
    "commands": [
      {
        "command": "apex-code-ai.openReviewer",
        "title": "Apex Code AI: Open Reviewer Panel"
      },
      {
        "command": "apex-code-ai.reviewCurrentFile",
        "title": "Apex Code AI: Review Current File"
      }
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^18.x",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "^1.125.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.x"
  }
}
